// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id          String             @id @default(cuid()) @db.VarChar(30)
  name        String             @db.VarChar(100)
  price       Decimal            @db.Decimal(10, 2)
  durationMin Int                @default(60) // czas trwania wizyty w minutach
  purchases   PurchasedService[]
  employees   EmployeeService[]
  bookings    Booking[]
}

model Transaction {
  id          String             @id @default(cuid()) @db.VarChar(30)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  totalAmount Decimal            @db.Decimal(10, 2)
  paymentType PaymentType
  services    PurchasedService[]
  bookings    Booking[]
  employee    Employee           @relation(fields: [employeeId], references: [id])
  employeeId  String             @db.VarChar(30) // pracownik, który przyjął płatność
}

model PurchasedService {
  id            String      @id @default(cuid()) @db.VarChar(30)
  service       Service     @relation(fields: [serviceId], references: [id])
  serviceId     String      @db.VarChar(30)
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  transactionId String      @db.VarChar(30)
  quantity      Int         @default(1)
  unitPrice     Decimal     @db.Decimal(10, 2) // snapshot ceny z momentu zakupu
}

model Employee {
  id                 String              @id @default(cuid()) @db.VarChar(30)
  name               String              @db.VarChar(100)
  email              String              @unique
  passwordHash       String?             @db.VarChar(100) // bcrypt; null = nie może się zalogować
  role               Role                @default(EMPLOYEE)
  failedLogins       Int                 @default(0) // nieudane logowania z rzędu
  lockedUntil        DateTime?           @db.Timestamptz(6) // blokada logowania po zbyt wielu próbach
  transactions       Transaction[]
  services           EmployeeService[]
  workingHours       WorkingHours[]
  shifts             Shift[]
  scheduleExceptions ScheduleException[]
  bookings           Booking[]
  sessions           AuthSession[]
  notifications      Notification[]
}

// Usługi, które dany pracownik wykonuje
model EmployeeService {
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String   @db.VarChar(30)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId  String   @db.VarChar(30)

  @@id([employeeId, serviceId])
}

// Szablon tygodniowy – z niego kierownik generuje grafik miesięczny; minuty od północy (czas salonu)
model WorkingHours {
  id          String   @id @default(cuid()) @db.VarChar(30)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String   @db.VarChar(30)
  weekday     Int // 1 = poniedziałek ... 7 = niedziela
  startMinute Int
  endMinute   Int

  @@index([employeeId, weekday])
}

// Urlop / dzień wolny / niedostępność w części dnia
model ScheduleException {
  id          String   @id @default(cuid()) @db.VarChar(30)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String   @db.VarChar(30)
  date        DateTime @db.Date
  startMinute Int? // null = cały dzień niedostępny
  endMinute   Int?
  reason      String?  @db.VarChar(255)

  @@index([employeeId, date])
}

// Grafik miesięczny: szkic → publikacja. Wolne terminy liczone są tylko z opublikowanych miesięcy.
model ScheduleMonth {
  id          String    @id @default(cuid()) @db.VarChar(30)
  month       String    @unique @db.Char(7) // "2026-10"
  publishedAt DateTime? @db.Timestamptz(6) // null = szkic
  shifts      Shift[]
}

// Zmiana pracownika w konkretnym dniu (jedno okno na dzień); minuty od północy, czas salonu
model Shift {
  id              String        @id @default(cuid()) @db.VarChar(30)
  scheduleMonth   ScheduleMonth @relation(fields: [scheduleMonthId], references: [id], onDelete: Cascade)
  scheduleMonthId String        @db.VarChar(30)
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId      String        @db.VarChar(30)
  date            DateTime      @db.Date
  startMinute     Int
  endMinute       Int

  @@unique([employeeId, date])
  @@index([scheduleMonthId])
  @@index([date])
}

model Booking {
  id            String        @id @default(cuid()) @db.VarChar(30)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  startAt       DateTime      @db.Timestamptz(6)
  endAt         DateTime      @db.Timestamptz(6)
  status        BookingStatus @default(CONFIRMED)
  clientName    String        @db.VarChar(100)
  clientPhone   String        @db.VarChar(30)
  note          String?       @db.VarChar(500)
  service       Service       @relation(fields: [serviceId], references: [id])
  serviceId     String        @db.VarChar(30)
  employee      Employee      @relation(fields: [employeeId], references: [id]) // specjalista
  employeeId    String        @db.VarChar(30)
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  transactionId String        @db.VarChar(30)

  @@index([employeeId, startAt])
}

// Sesja logowania (jedno urządzenie). Token JWT zawiera tylko jej id – usunięcie wiersza natychmiast wylogowuje.
model AuthSession {
  id         String   @id @default(cuid()) @db.VarChar(30)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String   @db.VarChar(30)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime @db.Timestamptz(6) // stałe 12 h od zalogowania

  @@index([employeeId])
}

// Powiadomienia dla kierowników (wspólne – przeczytane przez jednego są przeczytane dla wszystkich)
model Notification {
  id         String           @id @default(cuid()) @db.VarChar(30)
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  type       NotificationType
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade) // konto, którego dotyczy
  employeeId String           @db.VarChar(30)
  ipAddress  String?          @db.VarChar(45) // skąd były nieudane próby (z nagłówków żądania)
  readAt     DateTime?        @db.Timestamptz(6)

  @@index([createdAt])
}

enum NotificationType {
  ACCOUNT_LOCKED
}

enum PaymentType {
  CASH
  CARD
}

enum Role {
  EMPLOYEE
  RECEPTIONIST // rejestratorka: rezerwacje, płatności, transakcje, podgląd grafiku
  MANAGER
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}
